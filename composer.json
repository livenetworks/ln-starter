{
    "name": "livenetworks/ln-starter",
    "description": "Laravel foundation package — base controllers, models, DTOs, and middleware for dual-mode (browser + API) applications.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Live Networks",
            "homepage": "https://livenetworks.mk"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/mail": "^11.0|^12.0|^13.0",
        "laravel/sanctum": "^4.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6.10",
        "orchestra/testbench": "^9.17|^10.11|^11.2",
        "phpunit/phpunit": "^11.5.50|^12.0"
    },
    "autoload": {
        "psr-4": {
            "LiveNetworks\\LnStarter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LiveNetworks\\LnStarter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "verify-artifact": "@php scripts/verify-artifact.php"
    },
    "archive": {
        "exclude": [
            "/.github",
            "/.claude",
            "/.gitmodules",
            "/.gitignore",
            "/tests",
            "/scripts",
            "/phpunit.xml",
            "/vendor",
            "/composer.lock",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/node_modules",
            "/.env",
            "/.env.*",
            "*.log",
            "*.sqlite",
            "*.sqlite3",
            "/.idea",
            "/.vscode",
            "/.DS_Store"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "LiveNetworks\\LnStarter\\LnStarterServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
